{
  "name": "wa-intelligence",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:types": "supabase gen types typescript --local > packages/database/types.ts",
    "test:db": "for f in supabase/tests/*.sql; do echo \"\u2192 $f\"; psql \"${LOCAL_DATABASE_URL:-postgresql://postgres:postgres@127.0.0.1:54322/postgres}\" -v ON_ERROR_STOP=1 -f \"$f\" || exit 1; done"
  },
  "devDependencies": {
    "turbo": "^2.9.18",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@11.9.0"
}
